# Скопируй этот файл в .env и заполни значения
# cp .env.production.example .env

# ── База данных ────────────────────────────────────────────────────────────────
DB_USER=biology
DB_PASSWORD=ЗАМЕНИ_НА_СИЛЬНЫЙ_ПАРОЛЬ
DB_NAME=biology

# ── JWT ────────────────────────────────────────────────────────────────────────
# Генерация: openssl rand -hex 64
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА
JWT_REFRESH_SECRET=ЗАМЕНИ_НА_ДРУГУЮ_СЛУЧАЙНУЮ_СТРОКУ

# ── Админ-панель ───────────────────────────────────────────────────────────────
ADMIN_PASSWORD=ЗАМЕНИ_НА_ПАРОЛЬ_АДМИНКИ

# ── Telegram ───────────────────────────────────────────────────────────────────
BOT_TOKEN=ТОКЕН_БОТА_ОТ_BOTFATHER
ADMIN_CHAT_ID=ТВО_TELEGRAM_ID

# ── Домен (без слеша в конце) ──────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Email (опционально) ────────────────────────────────────────────────────────
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=БиоЛаб

# ── Прочее ─────────────────────────────────────────────────────────────────────
ASSIGNMENT_PRICE=10
