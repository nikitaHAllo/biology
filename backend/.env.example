PORT=3000
NODE_ENV=development

# JWT для веб-авторизации (обязательно задать в production)
JWT_SECRET=change_me_to_a_long_random_string
# опционально, по умолчанию 7d
# JWT_EXPIRES_IN=7d

# Почта для кодов подтверждения (если не задано — код только в логе сервера)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="БиоЛаб <noreply@example.com>"

# Альтернатива: Brevo (Sendinblue) transactional email API через HTTPS (443)
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=your_verified_from_email@example.com
# BREVO_SENDER_NAME=БиоЛаб

# Токен Telegram-бота
BOT_TOKEN=your_bot_token_here

# URL фронтенда (Mini App) — должен быть HTTPS для web_app кнопки
FRONTEND_URL=https://your-miniapp-url.example
# Строка подключения к PostgreSQL
# Формат: postgres://<пользователь>:<пароль>@<хост>:<порт>/<база_данных>
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biology
# ID чата/канала для уведомлений админа (число)
ADMIN_CHAT_ID=123456789
# Стоимость отправки задания 2-й части (в репкоинах)
ASSIGNMENT_PRICE=10
